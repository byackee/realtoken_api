<h1 class="mb-4">Modifier la Tâche</h1>

<div class="card">
  <div class="card-body">
    <form action="/edit/<%= job.id %>" method="POST">
      <div class="mb-3">
        <label for="name" class="form-label">Nom de la tâche</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= job.name %>" required>
      </div>
      
      <div class="mb-3">
        <label for="script_path" class="form-label">Script à exécuter</label>
        <select class="form-select" id="script_path" name="script_path" required>
          <% if (scripts && scripts.length > 0) { %>
            <% scripts.forEach(script => { %>
              <option value="<%= script.path %>" <%= job.script_path === script.path ? 'selected' : '' %>>
                <%= script.name %>
              </option>
            <% }); %>
          <% } else { %>
            <option value="<%= job.script_path %>" selected><%= job.script_path.split('/').pop() %></option>
          <% } %>
        </select>
        <div class="form-text">
          <% if (!scripts || scripts.length === 0) { %>
            <span class="text-warning">Aucun nouveau script disponible. Le script actuel sera conservé.</span>
          <% } %>
        </div>
      </div>
      
      <div class="mb-3">
        <label for="cron_expression" class="form-label">Expression Cron</label>
        <input type="text" class="form-control" id="cron_expression" name="cron_expression" 
               value="<%= job.cron_expression %>" required>
        <div class="form-text">
          Format: minute heure jour_du_mois mois jour_de_la_semaine<br>
          Exemples:
          <ul>
            <li><code>*/5 * * * *</code> - Toutes les 5 minutes</li>
            <li><code>0 * * * *</code> - Toutes les heures à la minute 0</li>
            <li><code>0 0 * * *</code> - Tous les jours à minuit</li>
            <li><code>0 12 * * 1-5</code> - Tous les jours de la semaine à midi</li>
          </ul>
        </div>
      </div>
      
      <div class="mb-3">
        <label for="description" class="form-label">Description (optionnelle)</label>
        <textarea class="form-control" id="description" name="description" rows="3"><%= job.description || '' %></textarea>
      </div>
      
      <div class="d-flex">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save"></i> Mettre à jour
        </button>
        <a href="/" class="btn btn-secondary ms-2">
          <i class="fas fa-arrow-left"></i> Annuler
        </a>
      </div>
    </form>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header bg-light">
    Informations complémentaires
  </div>
  <div class="card-body">
    <p><strong>Statut actuel:</strong> 
      <% if (job.status === 'running') { %>
        <span class="badge bg-success"><i class="fas fa-play-circle"></i> En cours</span>
      <% } else { %>
        <span class="badge bg-secondary"><i class="fas fa-stop-circle"></i> Arrêté</span>
      <% } %>
    </p>
    
    <p><strong>Dernière exécution:</strong> 
      <%= job.last_run ? new Date(job.last_run).toLocaleString('fr-FR') : 'Jamais' %>
    </p>
    
    <p><strong>Dernier résultat:</strong> 
      <% if (job.last_status === 'success') { %>
        <span class="badge bg-success"><i class="fas fa-check-circle"></i> Succès</span>
      <% } else if (job.last_status === 'failed') { %>
        <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Échec</span>
      <% } else { %>
        <span class="badge bg-secondary">Inconnu</span>
      <% } %>
    </p>
    
    <p><strong>Date de création:</strong> 
      <%= new Date(job.created_at).toLocaleString('fr-FR') %>
    </p>
  </div>
</div> 